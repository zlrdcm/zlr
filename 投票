#include <stdio.h>
#include <string.h>

//定义候选人结构体：名字、得票数
struct Candidate{
    char name[20];
    int count;
};

int main()
{
    //4位候选人，初始票数全部0
    struct Candidate can[4]={
        {"Li",0},
        {"Zhang",0},
        {"Sun",0},
        {"Wang",0}
    };

    int invalid = 0;      //无效票计数器
    char voteName[20];    //保存每次输入投票的名字

    //一共投8次票
    for(int i = 0; i < 8; i++)
    {
        printf("请输入第%d次投票：",i+1);
        scanf("%s", voteName);   //数组名本身是地址，不加&

        int flag = 0;   //0=没找到候选人；1=找到

        //遍历4个候选人对比名字
        for(int j = 0; j < 4; j++)
        {
            //strcmp相等返回0
            if(strcmp(voteName, can[j].name) == 0)
            {
                can[j].count++;   //对应人票数+1
                flag = 1;         //标记这一票有效
                break;            //找到了，不用继续对比剩下候选人
            }
        }

        //内层循环走完，如果flag还是0：没有匹配任何人 →无效票
        if(flag == 0)
        {
            invalid++;
        }
    }

    //输出投票结果
    printf("\n====投票结果====\n");
    for(int j = 0; j <4; j++)
    {
        printf("%s：%d 票\n", can[j].name, can[j].count);
    }
    printf("无效票数：%d\n", invalid);

    return 0;
} 
